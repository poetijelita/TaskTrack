{
  "name": "tasktrack/bnsp",
  "description": "Aplikasi manajemen tugas pribadi",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "TaskTrack\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "TaskTrack\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests",
    "analyse": "phpstan analyse src --level=5"
  }
}
